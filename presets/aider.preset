---
name: aider
binary: aider
description: Aider AI pair programming tool
---
# ── Aider data ─────────────────────────────────────────────────────────────────
# Read/write: stores conversation history, model config, and session state.
rw  ~/.aider

# ── Environment ────────────────────────────────────────────────────────────────
# The base above starts the sandbox with an empty environment, so the keys this
# agent reads have to be named here. Names that are unset on the host are
# skipped silently; add any others your setup uses.
[env]
pass  = OPENAI_API_KEY OPENAI_API_BASE ANTHROPIC_API_KEY
pass  = GEMINI_API_KEY DEEPSEEK_API_KEY AIDER_MODEL
