---
name: claude-code
binary: claude
description: Claude Code AI coding assistant by Anthropic
---
# ── Node.js runtime ────────────────────────────────────────────────────────────
# Read-only: agent uses node/npm from your version manager.
ro? ~/.nvm
ro? ~/.fnm
ro? ~/.volta
ro? ~/.asdf

# ── npm package cache ──────────────────────────────────────────────────────────
# Read/write: cached packages persist across sessions, speeding up npm install.
rw  ~/.npm

# ── Claude Code credentials ────────────────────────────────────────────────────
# Read/write: stores session token so you don't re-authenticate every run.
rw  ~/.claude
rw? ~/.claude.json

# ── Environment ────────────────────────────────────────────────────────────────
# The base above starts the sandbox with an empty environment, so the keys this
# agent reads have to be named here. Names that are unset on the host are
# skipped silently; add any others your setup uses.
[env]
pass  = ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL
pass  = ANTHROPIC_MODEL CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
