---
name: opencode
binary: opencode
description: OpenCode AI coding assistant
---
# ── OpenCode config ────────────────────────────────────────────────────────────
# Read/write: stores settings, custom commands, and model configuration.
rw  ~/.config/opencode

# ── OpenCode data ──────────────────────────────────────────────────────────────
# Read/write: stores session history and agent state.
rw  ~/.local/share/opencode

# ── npm package cache ──────────────────────────────────────────────────────────
# Read/write: cached packages persist across sessions.
rw  ~/.npm

# ── Environment ────────────────────────────────────────────────────────────────
# The base above starts the sandbox with an empty environment, so the keys this
# agent reads have to be named here. Names that are unset on the host are
# skipped silently; add any others your setup uses.
[env]
pass  = OPENAI_API_KEY ANTHROPIC_API_KEY GEMINI_API_KEY OPENROUTER_API_KEY
