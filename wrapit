#!/usr/bin/env bash
# wrapit — sandbox AI agent harnesses using bubblewrap

WRAPIT_VERSION="0.1.0"

# ---------------------------------------------------------------------------
# Bash version check (require 3.2+)
# ---------------------------------------------------------------------------
_check_bash_version() {
  local major="${BASH_VERSINFO[0]:-0}"
  local minor="${BASH_VERSINFO[1]:-0}"
  if [ "$major" -lt 3 ] || { [ "$major" -eq 3 ] && [ "$minor" -lt 2 ]; }; then
    printf 'wrapit: requires bash 3.2 or later (found %s)\n' "$BASH_VERSION" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Runtime dependency checks
# ---------------------------------------------------------------------------
_check_deps() {
  local missing=""
  for cmd in grep sed awk cut dirname realpath mktemp; do
    command -v "$cmd" > /dev/null 2>&1 || missing="$missing $cmd"
  done
  if [ -n "$missing" ]; then
    printf 'wrapit: missing required tools:%s\n' "$missing" >&2
    exit 1
  fi
}

_check_bwrap() {
  if ! command -v bwrap > /dev/null 2>&1; then
    printf 'wrapit: bwrap not found.\n' >&2
    printf 'Install bubblewrap:\n' >&2
    if [ -f /etc/os-release ]; then
      local id
      id="$(. /etc/os-release && printf '%s' "${ID:-}")"
      case "$id" in
        ubuntu|debian) printf '  sudo apt install bubblewrap\n' >&2 ;;
        fedora|rhel|centos) printf '  sudo dnf install bubblewrap\n' >&2 ;;
        arch) printf '  sudo pacman -S bubblewrap\n' >&2 ;;
        opensuse*) printf '  sudo zypper install bubblewrap\n' >&2 ;;
        *) printf '  (check your distro package manager for "bubblewrap")\n' >&2 ;;
      esac
    fi
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Source lib files relative to this script (resolves symlinks)
# ---------------------------------------------------------------------------
_WRAPIT_SELF="${BASH_SOURCE[0]}"
# Follow symlinks until we reach the real file
while [ -L "$_WRAPIT_SELF" ]; do
  _WRAPIT_SELF="$(readlink "$_WRAPIT_SELF")"
  case "$_WRAPIT_SELF" in
    /*) ;;
    *) _WRAPIT_SELF="$(dirname "${BASH_SOURCE[0]}")/$_WRAPIT_SELF" ;;
  esac
done
_WRAPIT_DIR="$(cd "$(dirname "$_WRAPIT_SELF")" && pwd)"
unset _WRAPIT_SELF
source "${_WRAPIT_DIR}/lib/parse.sh"
source "${_WRAPIT_DIR}/lib/build_bwrap.sh"
source "${_WRAPIT_DIR}/lib/check.sh"
source "${_WRAPIT_DIR}/lib/presets.sh"
source "${_WRAPIT_DIR}/lib/init.sh"
source "${_WRAPIT_DIR}/lib/test.sh"

# ---------------------------------------------------------------------------
# .wrapit discovery: walk up from $PWD toward /
# ---------------------------------------------------------------------------
_find_wrapit() {
  local dir="$PWD"
  while true; do
    if [ -f "$dir/.wrapit" ]; then
      printf '%s/.wrapit' "$dir"
      return 0
    fi
    local parent
    parent="$(dirname "$dir")"
    [ "$parent" = "$dir" ] && break
    dir="$parent"
  done
  return 1
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
_usage() {
  local preset_list
  preset_list="$(list_presets 2>/dev/null | tr '\n' ' ')"
  preset_list="${preset_list% }"
  [ -n "$preset_list" ] || preset_list="(no presets found in ${WRAPIT_PRESETS_DIR})"

  cat <<EOF
Usage:
  wrapit [options] <command> [args...]
  wrapit --init [--preset <harness>]
  wrapit --test
  wrapit --dry-run <command> [args...]
  wrapit --check
  wrapit --version
  wrapit --help

Options:
  --init [--preset <harness>]  Create .wrapit config (interactive or from preset)
  --dry-run                    Print the bwrap command without executing
  --test                       Run sandbox integrity tests (T1-T6)
  --check                      Validate .wrapit config
  --force                      Bypass non-blocking security warnings
  --version                    Print version
  --help                       Show this help

Known presets: ${preset_list}
EOF
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
_check_bash_version
_check_deps

# Parse flags before delegating; capture the sandboxed command as an array
do_init=false
do_test=false
do_dry_run=false
do_check=false
do_version=false
do_help=false
force_flag=""
preset_name=""
# cmd_args: the command and its arguments to run inside the sandbox
cmd_args=()

while [ $# -gt 0 ]; do
  case "$1" in
    --init)
      do_init=true
      shift
      ;;
    --preset)
      shift
      preset_name="${1:-}"
      shift
      ;;
    --test)
      do_test=true
      shift
      ;;
    --dry-run)
      do_dry_run=true
      shift
      ;;
    --check)
      do_check=true
      shift
      ;;
    --force)
      force_flag="--force"
      shift
      ;;
    --version)
      do_version=true
      shift
      ;;
    --help|-h)
      do_help=true
      shift
      ;;
    --)
      shift
      cmd_args=("$@")
      break
      ;;
    *)
      cmd_args=("$@")
      break
      ;;
  esac
done

if [ "$do_version" = "true" ]; then
  printf 'wrapit %s\n' "$WRAPIT_VERSION"
  exit 0
fi

if [ "$do_help" = "true" ]; then
  _usage
  exit 0
fi

if [ "$do_init" = "true" ]; then
  if [ -n "$preset_name" ]; then
    run_init --preset "$preset_name"
  else
    run_init
  fi
  exit $?
fi

# All remaining commands need a .wrapit file (--check just reads it)

if [ "$do_check" = "true" ]; then
  config="$(_find_wrapit)" || {
    printf 'wrapit: no .wrapit file found. Run `wrapit --init` to create one.\n' >&2
    exit 1
  }
  check_status=0
  # The user defaults file is merged into every project, so scan it too.
  defaults="$(wrapit_defaults_file)"
  if [ -n "$defaults" ] && [ -f "$defaults" ]; then
    printf 'Checking %s\n' "$defaults"
    # shellcheck disable=SC2086
    check_wrapit "$defaults" $force_flag || check_status=1
    printf 'Checking %s\n' "$config"
  fi
  # shellcheck disable=SC2086
  check_wrapit "$config" $force_flag || check_status=1
  exit $check_status
fi

_check_bwrap

config="$(_find_wrapit)" || {
  printf 'wrapit: no .wrapit file found. Run `wrapit --init` to create one.\n' >&2
  exit 1
}

if [ "$do_test" = "true" ]; then
  run_sandbox_tests "$config"
  exit $?
fi

# Build the bwrap argv into an array. Never via eval: the sandboxed command's
# own quoting has to survive intact.
load_bwrap_argv "$config" || exit 1

if [ "$do_dry_run" = "true" ]; then
  printf 'bwrap'
  for arg in "${WRAPIT_BWRAP_ARGV[@]}" "${cmd_args[@]}"; do
    printf ' %q' "$arg"
  done
  printf '\n'
  exit 0
fi

# Execute: replace this process with bwrap running the sandboxed command
exec bwrap "${WRAPIT_BWRAP_ARGV[@]}" "${cmd_args[@]}"
